<%- include('partials/header', { user: null, title: 'Log in' }) %>

<div class="login-wrap">

  <div class="card login-card">

    <h1>
      Welcome back
    </h1>

    <p class="sub">
      Log in to the Assignment Submission System
    </p>


    <% if (error) { %>

      <div class="alert alert-error">
        <%= error %>
      </div>

    <% } %>


    <form method="POST" action="/login">

      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >


      <div class="form-group">

        <label for="email">
          Email
        </label>

        <input
          type="email"
          id="email"
          name="email"
          required
          autofocus
        >

      </div>


      <div class="form-group">

        <label for="password">
          Password
        </label>

        <input
          type="password"
          id="password"
          name="password"
          required
        >

      </div>


      <button
        type="submit"
        class="btn"
        style="width:100%"
      >
        Log in
      </button>

    </form>


    <div class="demo-creds">

      <strong>
        Demo accounts
      </strong>

      (after running <code>npm run seed</code>):<br>

      Faculty: faculty@example.com / faculty123<br>
      Student: student@example.com / student123

    </div>

  </div>

</div>


<%- include('partials/footer') %>